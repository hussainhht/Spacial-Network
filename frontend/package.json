{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:smoke": "bash tests/run-smoke.sh",
    "dev:demo": "node scripts/demo.mjs dev",
    "build:demo": "node scripts/demo.mjs build",
    "serve:demo": "node scripts/serve-demo.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:demo": "node --import ./tests/register.mjs --test tests/demo.test.mjs tests/validate-demo-assets.test.mjs",
    "test:demo:browser": "playwright test",
    "check:demo:assets": "node scripts/validate-demo-assets.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
